# ================================================================
# POLYMARKET TRADER FINDER — Configuration
# ================================================================
# Copie ce fichier vers .env et remplis les valeurs

# Clé OpenAI (obligatoire pour l'analyse IA)
# → https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ================================================================
# PARAMÈTRES DE SCAN (optionnel — valeurs par défaut en commentaire)
# ================================================================

# Nombre de marchés à scanner pour découvrir des traders (défaut: 40)
# MARKETS_TO_SCAN=40

# Nombre max de traders à analyser (défaut: 60)
# MAX_TRADERS=60

# Jours de lookback pour l'analyse (défaut: 30)
# LOOKBACK_DAYS=30

# Prix d'achat moyen maximum pour être considéré "positionnel" (défaut: 0.70)
# Traders avec avg_buy_price > cette valeur = news traders → éliminés avant OpenAI
# MAX_AVG_BUY_PRICE=0.70

# ================================================================
# NOTES
# ================================================================
# Coût OpenAI estimé : ~$0.01-0.05 par run complet (gpt-4o-mini)
# Durée d'un scan : 15-30 minutes selon le nombre de traders
# Résultats exportés dans : output/results.txt
